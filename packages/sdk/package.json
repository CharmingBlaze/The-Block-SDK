{
  "name": "@modeling-kit/sdk",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ai": {
      "types": "./src/ai.ts",
      "import": "./src/ai.ts"
    },
    "./three": {
      "types": "./src/three.ts",
      "import": "./src/three.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/ai.ts src/three.ts --format esm --dts --clean --sourcemap --external @modeling-kit/three-adapter --external three",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modeling-kit/commands": "workspace:*",
    "@modeling-kit/tools": "workspace:*",
    "@modeling-kit/materials": "workspace:*",
    "@modeling-kit/uv": "workspace:*",
    "@modeling-kit/rigging": "workspace:*",
    "@modeling-kit/animation": "workspace:*",
    "@modeling-kit/paint": "workspace:*",
    "@modeling-kit/formats": "workspace:*",
    "@modeling-kit/workers": "workspace:*",
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/mesh": "workspace:*",
    "@modeling-kit/document": "workspace:*",
    "@modeling-kit/history": "workspace:*",
    "@modeling-kit/math": "workspace:*",
    "@modeling-kit/selection": "workspace:*",
    "@modeling-kit/scene": "workspace:*",
    "@modeling-kit/validation": "workspace:*",
    "@modeling-kit/transform": "workspace:*",
    "@modeling-kit/snapping": "workspace:*",
    "@modeling-kit/primitives": "workspace:*",
    "@modeling-kit/input": "workspace:*"
  },
  "peerDependencies": {
    "@modeling-kit/three-adapter": "workspace:*",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@modeling-kit/three-adapter": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
