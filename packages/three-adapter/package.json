{
  "name": "@modeling-kit/three-adapter",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "three": "^0.180.0"
  },
  "dependencies": {
    "@modeling-kit/animation": "workspace:*",
    "@modeling-kit/commands": "workspace:*",
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/document": "workspace:*",
    "@modeling-kit/math": "workspace:*",
    "@modeling-kit/mesh": "workspace:*",
    "@modeling-kit/rigging": "workspace:*",
    "@modeling-kit/scene": "workspace:*",
    "@modeling-kit/selection": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "description": "Derived Three.js viewport, picking, and overlays",
  "homepage": "https://github.com/CharmingBlaze/The-Block-SDK/tree/main/packages/three-adapter",
  "bugs": {
    "url": "https://github.com/CharmingBlaze/The-Block-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharmingBlaze/The-Block-SDK.git",
    "directory": "packages/three-adapter"
  },
  "keywords": [
    "3d",
    "three",
    "viewport",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
