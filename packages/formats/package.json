{
  "name": "@modeling-kit/formats",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/browser.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@modeling-kit/animation": "workspace:*",
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/document": "workspace:*",
    "@modeling-kit/math": "workspace:*",
    "@modeling-kit/mesh": "workspace:*",
    "@modeling-kit/rigging": "workspace:*",
    "@modeling-kit/scene": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "description": "glTF, OBJ, STL, PLY, and PPM interchange for modeling-kit",
  "homepage": "https://github.com/CharmingBlaze/The-Block-SDK/tree/main/packages/formats",
  "bugs": {
    "url": "https://github.com/CharmingBlaze/The-Block-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharmingBlaze/The-Block-SDK.git",
    "directory": "packages/formats"
  },
  "keywords": [
    "3d",
    "gltf",
    "obj",
    "stl",
    "ply",
    "interchange",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
