{
  "name": "@modeling-kit/transform",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/document": "workspace:*",
    "@modeling-kit/math": "workspace:*",
    "@modeling-kit/mesh": "workspace:*",
    "@modeling-kit/scene": "workspace:*",
    "@modeling-kit/snapping": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Object and component transforms for modeling-kit",
  "homepage": "https://github.com/CharmingBlaze/The-Block-SDK/tree/main/packages/transform",
  "bugs": {
    "url": "https://github.com/CharmingBlaze/The-Block-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharmingBlaze/The-Block-SDK.git",
    "directory": "packages/transform"
  },
  "keywords": [
    "3d",
    "transform",
    "gizmo",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
