{
  "name": "@modeling-kit/workers",
  "version": "0.1.0",
  "description": "Asynchronous compute worker boundaries for heavy mesh operations",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@modeling-kit/mesh": "workspace:*",
    "@modeling-kit/uv": "workspace:*",
    "@modeling-kit/validation": "workspace:*"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "homepage": "https://github.com/CharmingBlaze/The-Block-SDK/tree/main/packages/workers",
  "bugs": {
    "url": "https://github.com/CharmingBlaze/The-Block-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharmingBlaze/The-Block-SDK.git",
    "directory": "packages/workers"
  },
  "keywords": [
    "3d",
    "workers",
    "mesh",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
