{
  "name": "@modeling-kit/input",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dom.json"
  },
  "dependencies": {
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/math": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Headless actions and gestures with an optional DOM bind",
  "homepage": "https://github.com/CharmingBlaze/The-Block-SDK/tree/main/packages/input",
  "bugs": {
    "url": "https://github.com/CharmingBlaze/The-Block-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharmingBlaze/The-Block-SDK.git",
    "directory": "packages/input"
  },
  "keywords": [
    "3d",
    "input",
    "keymap",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
