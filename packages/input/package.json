{
  "name": "@modeling-kit/input",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./dom": {
      "types": "./src/dom.ts",
      "import": "./src/dom.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dom.json"
  },
  "dependencies": {
    "@modeling-kit/core": "workspace:*",
    "@modeling-kit/math": "workspace:*"
  }
}
