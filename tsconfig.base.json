{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@modeling-kit/animation": ["./packages/animation/src/index.ts"],
      "@modeling-kit/commands": ["./packages/commands/src/index.ts"],
      "@modeling-kit/core": ["./packages/core/src/index.ts"],
      "@modeling-kit/document": ["./packages/document/src/index.ts"],
      "@modeling-kit/formats": ["./packages/formats/src/index.ts"],
      "@modeling-kit/formats/node": ["./packages/formats/src/node.ts"],
      "@modeling-kit/formats/browser": ["./packages/formats/src/browser.ts"],
      "@modeling-kit/history": ["./packages/history/src/index.ts"],
      "@modeling-kit/input": ["./packages/input/src/index.ts"],
      "@modeling-kit/input/dom": ["./packages/input/src/dom.ts"],
      "@modeling-kit/materials": ["./packages/materials/src/index.ts"],
      "@modeling-kit/math": ["./packages/math/src/index.ts"],
      "@modeling-kit/mesh": ["./packages/mesh/src/index.ts"],
      "@modeling-kit/meshopt": ["./packages/meshopt/src/index.ts"],
      "@modeling-kit/paint": ["./packages/paint/src/index.ts"],
      "@modeling-kit/primitives": ["./packages/primitives/src/index.ts"],
      "@modeling-kit/rigging": ["./packages/rigging/src/index.ts"],
      "@modeling-kit/scene": ["./packages/scene/src/index.ts"],
      "@modeling-kit/sdk": ["./packages/sdk/src/index.ts"],
      "@modeling-kit/sdk/ai": ["./packages/sdk/src/ai.ts"],
      "@modeling-kit/sdk/three": ["./packages/sdk/src/three.ts"],
      "@modeling-kit/selection": ["./packages/selection/src/index.ts"],
      "@modeling-kit/snapping": ["./packages/snapping/src/index.ts"],
      "@modeling-kit/three-adapter": ["./packages/three-adapter/src/index.ts"],
      "@modeling-kit/tools": ["./packages/tools/src/index.ts"],
      "@modeling-kit/transform": ["./packages/transform/src/index.ts"],
      "@modeling-kit/uv": ["./packages/uv/src/index.ts"],
      "@modeling-kit/validation": ["./packages/validation/src/index.ts"],
      "@modeling-kit/workers": ["./packages/workers/src/index.ts"],
      "@modeling-kit/workers/browser": ["./packages/workers/src/browser.ts"],
      "@modeling-kit/workers/node": ["./packages/workers/src/node.ts"]
    }
  }
}
